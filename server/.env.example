PORT=8080
MONGO_URI=mongodb://localhost:27017/CamConnector
JWT_SECRET=replace_this_with_a_long_random_string

# Gmail account used to send the password-reset email. With Gmail you must use a
# 16-character App Password (https://myaccount.google.com/apppasswords), not
# your normal login password.
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# Base URL of the frontend that hosts the /reset-password/:token page. The link
# inside the reset email is built from this value.
CLIENT_URL=http://localhost:5173
